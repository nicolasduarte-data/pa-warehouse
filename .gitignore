# pa-warehouse — .gitignore
# CRITICAL: this file is the perimeter against committing credentials.
# Anything matching these patterns must NEVER appear in git history.

# ─── Credentials (HARD RULE — never commit) ──────────────────────────
.env
.env.local
.env.*
# GCP service account JSON keys (comments must sit on their own line;
# an inline "# ..." becomes part of the pattern and the rule never matches)
*.json
# but allow npm package.json and dbt packages.json
!package.json
!packages.json
# contains BigQuery + Snowflake creds
dbt/profiles.yml
# executed bootstrap copy: carries the real RSA public key + account wiring
scripts/snowflake_bootstrap_run.sql
profiles.yml
**/credentials.txt
**/secrets/

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── dbt build artifacts ─────────────────────────────────────────────
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ─── Generated data (regenerable; not source-of-truth) ───────────────
# Keep `data/raw/.gitkeep` if needed; CSVs themselves are regenerated by generator/generate.py
data/raw/*.csv
data/processed/*.csv
data/raw_smoke/
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.log

# ─── Local working notes (not published) ─────────────────────────────
BACKLOG.md
