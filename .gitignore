# pa-warehouse — .gitignore
# CRITICAL: this file is the perimeter against committing credentials.
# Anything matching these patterns must NEVER appear in git history.

# ─── Credentials (HARD RULE — never commit) ──────────────────────────
.env
.env.local
.env.*
*.json                          # GCP service account JSON keys
!package.json                   # but allow npm package.json if added
!packages.json                  # and dbt packages.json
dbt/profiles.yml                # contains BigQuery + Snowflake creds
profiles.yml
**/credentials.txt
**/secrets/

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── dbt build artifacts ─────────────────────────────────────────────
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ─── Generated data (regenerable; not source-of-truth) ───────────────
# Keep `data/raw/.gitkeep` if needed; CSVs themselves are regenerated by generator/generate.py
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log
